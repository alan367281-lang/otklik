{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Отклик",
  "version": "0.2.0",
  "identifier": "app.otklik.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Отклик",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NzFCQkJDMTk2RTJGMUEKUldRYUwyNFp2THR4RmRvVnRhR3J6aGx1cjJnbDJnZjB1WlNvaUlHSGNZUVlmazFQREZldXMyaVYK",
      "endpoints": ["https://github.com/alan367281-lang/otklik/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Отклик",
    "copyright": "Отклик",
    "shortDescription": "Горячие клавиши и заготовки текста",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Отклик"
      }
    }
  }
}
